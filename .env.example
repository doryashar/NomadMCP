# NomadMCP Configuration via Environment Variables

# OpenCode server settings
NOMAD_MCP_OPENCODE_BINARY=opencode
NOMAD_MCP_SERVER_TIMEOUT=10.0

# PR management settings
NOMAD_MCP_PR_POLL_INTERVAL=30.0

# Task settings
NOMAD_MCP_DEFAULT_TIMEOUT=60
NOMAD_MCP_BRANCH_PREFIX=task

# Logging settings
NOMAD_MCP_LOG_LEVEL=INFO
# NOMAD_MCP_LOG_FILE=/var/log/nomad-mcp.log
